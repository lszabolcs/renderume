{
	"name": "renderume",
	"version": "0.0.0",
	"private": true,
	"description": "A local-first résumé renderer for developers.",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"cv": "tsx src/cli.ts",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"check": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"commander": "^14.0.0",
		"gray-matter": "^4.0.3",
		"markdown-it": "^14.1.0",
		"playwright": "^1.55.0",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^24.0.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.4"
	}
}
